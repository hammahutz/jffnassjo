---
import PageLayout from "../layout/PageLayout.astro";
import Form from "../components/Forms/Form.astro";

const pageTitle = "Kontakt";

const formInputs = [
  { type: "text", name: "Förnamn" },
  { type: "text", name: "Efternamn" },
  { type: "email", name: "Email" },
  { type: "textarea", name: "Medelande" },
];
---

<PageLayout pageTitle={pageTitle}>
  <article class="flex flex-col gap-10 itm px-smallScreen xl:px-largeScreen 2xl:px-extraLargeScreen pb-10">
    <section>
      <h1>{pageTitle}</h1>
      <hr />
      <p>Skicka ett medelande med dina uppgifter till JFF:s styrelsen nedan.</p>
    </section>
  </article>
  <article class="">
    <section>
      <Form name={pageTitle} formInputs={formInputs} />
    </section>
  </article>
</PageLayout>
