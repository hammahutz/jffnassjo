---
import PageLayout from "../layout/PageLayout.astro";
import Carousel from "../components/Carousel/Carousel";

const pageTitle = "Pallarp";

const images = [
  {
    src: "/images/Pallarp/DSC_1847-1024x685.jpg",
    alt: "pallarp",
  },
  {
    src: "/images/Pallarp/DSC_1833-1024x685.jpg",
    alt: "pallarp",
  },
  {
    src: "/images/Pallarp/DSC_1830-1024x685.jpg",
    alt: "pallarp",
  },
];
---

<PageLayout pageTitle={pageTitle}>
  <article class="flex flex-col gap-10 itm px-smallScreen xl:px-largeScreen 2xl:px-extraLargeScreen pb-10">
    <h1>{pageTitle}</h1>
    <hr />
    <section class="flex flex-col gap-2 pb-8">
      <p>Pallarp är JFF Nässjös fritidsanläggning. Här kan du bada, grilla, bada bastu och fiska. Alla medlemar är välkommna ut!</p>
      <p>Det går även att hyra, se fliken <a href="jffnassjo.se/bli-medlem" class="underline">Bokning</a></p>
      <p>Är du inte medlem, men vill bli, är du välkommen att ansöka i fliken <a href="jffnassjo.se/bli-medlem" class="underline">Bli medlem</a></p>
    </section>
    <Carousel client:only images={images} />
  </article>
</PageLayout>
